<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.mdm.mapper.ItemMapper">
<select id="GetIdByMaterialId" parameterType="java.lang.String" resultType="java.lang.String">
    SELECT id
    FROM mis_item
    WHERE item_id = #{materialId}
</select>
</mapper>