<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.mdm.mapper.ProcessRoutingStepMapper">

	<delete id="deleteByMainId" parameterType="java.lang.String">
		DELETE 
		FROM  mis_process_routing_step 
		WHERE
			 routing_id = #{mainId} 	</delete>
	
	<select id="selectByMainId" parameterType="java.lang.String" resultType="org.jeecg.modules.mdm.entity.ProcessRoutingStep">
		SELECT * 
		FROM  mis_process_routing_step
		WHERE
			 routing_id = #{mainId}
		ORDER BY step_seq </select>
</mapper>
