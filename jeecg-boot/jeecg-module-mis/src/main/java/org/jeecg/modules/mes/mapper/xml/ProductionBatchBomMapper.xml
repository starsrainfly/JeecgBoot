<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.mes.mapper.ProductionBatchBomMapper">

	<delete id="deleteByMainId" parameterType="java.lang.String">
		DELETE 
		FROM  mis_production_batch_bom 
		WHERE
			 batch_id = #{mainId} 	</delete>
	
	<select id="selectByMainId" parameterType="java.lang.String" resultType="org.jeecg.modules.mes.entity.ProductionBatchBom">
		SELECT * 
		FROM  mis_production_batch_bom
		WHERE
			 batch_id = #{mainId} 	</select>
</mapper>
