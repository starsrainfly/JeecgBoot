<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.scm.mapper.CustomerSalesmanMapper">

	<delete id="deleteByMainId" parameterType="java.lang.String">
		DELETE 
		FROM  mis_customer_salesman 
		WHERE
			 customer_id = #{mainId} 	</delete>
	
	<select id="selectByMainId" parameterType="java.lang.String" resultType="org.jeecg.modules.scm.entity.CustomerSalesman">
		SELECT * 
		FROM  mis_customer_salesman
		WHERE
			 customer_id = #{mainId} 	</select>
</mapper>
