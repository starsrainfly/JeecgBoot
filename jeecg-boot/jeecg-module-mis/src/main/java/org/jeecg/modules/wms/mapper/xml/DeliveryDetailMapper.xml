<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.wms.mapper.DeliveryDetailMapper">

	<delete id="deleteByMainId" parameterType="java.lang.String">
		DELETE 
		FROM  mis_delivery_detail 
		WHERE
			 delivery_id = #{mainId} 	</delete>
	
	<select id="selectByMainId" parameterType="java.lang.String" resultType="org.jeecg.modules.wms.entity.DeliveryDetail">
		SELECT * 
		FROM  mis_delivery_detail
		WHERE
			 delivery_id = #{mainId} 	</select>

	<select id="sumDeliveredQtyBySourceDetailId" resultType="java.math.BigDecimal">
		SELECT COALESCE(SUM(actual_qty), 0)
		FROM mis_delivery_detail
		WHERE source_detail_id = #{sourceDetailId} AND del_flag = '0'
	</select>
</mapper>
