<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.wms.mapper.WarehouseAreaMapper">

    <select id="getAreaByCode" resultType="org.jeecg.modules.wms.entity.WarehouseArea">
        SELECT *
        FROM mis_warehouse_area
        WHERE area_code = #{areaCode}
    </select>
</mapper>